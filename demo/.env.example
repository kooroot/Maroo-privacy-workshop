# Maroo testnet — https://docs.maroo.io/resources/network/testnet-access
MAROO_RPC_URL=https://rpc-testnet.maroo.io
MAROO_CHAIN_ID=450815
MAROO_EXPLORER_URL=https://explorer-testnet.maroo.io
MAROO_FAUCET_URL=https://faucet.maroo.io
MAROO_INDEXER_URL=https://explorer-testnet.maroo.io/blockscout/api/v2
MAROO_KYC_URL=https://kyc-testnet.maroo.io

# Core precompiles — https://docs.maroo.io/resources/contracts/deployed-contracts
MAROO_OKRW_PRECOMPILE=0x1000000000000000000000000000000000000001
MAROO_PCL_PRECOMPILE=0x1000000000000000000000000000000000000005
MAROO_EAS_PRECOMPILE=0x1000000000000000000000000000000000000009

# Privacy precompile — https://docs.maroo.io/concepts/privacy/privacy-precompile-overview
MAROO_PRIVACY_PRECOMPILE=0x100000000000000000000000000000000000000b

# Company treasury/operator EVM account. It signs deposit and transfer calls.
COMPANY_ACCOUNT=0xREPLACE_WITH_COMPANY_TESTNET_ADDRESS

# Testnet-only company signer key. It must derive COMPANY_ACCOUNT.
# Keep the real value only in demo/.env; never commit or screen-share it.
COMPANY_PRIVATE_KEY=REPLACE_WITH_COMPANY_TESTNET_PRIVATE_KEY

# Public employee EVM account for role separation and a future public withdrawal target.
# IPrivacy.transfer pays a shielded profile encoded in its proof/output, not this EVM address.
EMPLOYEE_ACCOUNT=0xREPLACE_WITH_EMPLOYEE_TESTNET_ADDRESS
